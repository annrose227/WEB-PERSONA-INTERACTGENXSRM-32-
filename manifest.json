{
  "manifest_version": 3,
  "name": "WebPersona Extension",
  "version": "0.0.0",
  "description": "Autonomous browsing AI widget that appears on websites",
  "permissions": ["activeTab", "storage", "scripting"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "WebPersona"
  },

  "web_accessible_resources": [
    {
      "resources": ["dist/assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
